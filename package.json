{
  "name": "vault-publisher",
  "version": "0.0.1",
  "description": "Publish an Obsidian vault as a static website, rendered by Obsidian itself.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": [],
  "author": "NoteNerd",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "^5.7.2"
  }
}
