filters:
  and:
    - file.hasTag("book")
    - 'file.ext == "md"'

formulas:
  status_icon: 'if(status == "done", "Read", if(status == "reading", "Reading", "Queued"))'
  weight: 'if(pages, (pages / 100).round(1), "")'

properties:
  author:
    displayName: Author
  formula.status_icon:
    displayName: State
  formula.weight:
    displayName: "Hundreds of pages"

views:
  - type: table
    name: "All books"
    order:
      - file.name
      - author
      - formula.status_icon
      - rating
      - pages
      - formula.weight
    summaries:
      pages: Sum

  - type: cards
    name: "Shelf"
    order:
      - file.name
      - author
      - rating
