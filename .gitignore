node_modules/

# Build output. main.js is generated by esbuild from src/.
main.js
main.js.map

# Docs and research stay local, by decision.
docs/
research/

# Local working agreement, not part of the published plugin.
# AGENTS.md is a symlink to CLAUDE.md, for agents that read that name.
CLAUDE.md
AGENTS.md

# Test vaults live outside the repo, so the plugin source is never confused
# with the content used to exercise it. See docs/PLAN.md for the path.
**/_spike-output/
**/_site-preview/

# Which vault `npm run deploy` copies into. One line, a path, local to this
# clone: the vault's name is the owner's business and does not belong in
# committed source. Created by hand; see CLAUDE.md.
.vault-path

# A vault folder opened by mistake leaves one of these behind.
/.obsidian/

.DS_Store
*.log
.playwright-mcp/
