#!/bin/sh
#
# Keeps tool attribution out of commit messages.
#
# A commit here is authored by the person who made it. A trailer crediting
# the editor, the assistant or the generator that helped is noise in a log
# that is read to find out who to ask about a change.
#
# This is a house rule, not a judgement about anyone else's: credit a human
# collaborator in the message body in prose, or relax the check in your own
# fork. It is a check rather than a note in a file because a note only
# reaches whoever read it.

set -e
msg_file="$1"
fail=0
say() { printf '\033[31mcommit-msg:\033[0m %s\n' "$1" >&2; fail=1; }

# Comment lines are git's own template, not part of the message.
body=$(grep -v '^#' "$msg_file" || true)

printf '%s' "$body" | grep -qiE '^[[:space:]]*co-authored-by:' \
  && say "message carries a Co-Authored-By trailer"

printf '%s' "$body" | grep -qiE 'generated with|co-?authored (by|with) (claude|an? (ai|llm|assistant))|🤖' \
  && say "message credits a tool"

if [ "$fail" -ne 0 ]; then
  printf '\nRemove the attribution line.\n' >&2
  exit 1
fi
